"""
FermentaLab SQLite schema migrations.

Migrations must preserve existing fermentation records,
execute atomically, and reject unsupported schema versions.

No hardware control is performed by this module.
"""

SCHEMA_VERSION = 2

RUN_STATUSES = frozenset({
    "created",
    "running",
    "paused",
    "completed",
    "cancelled",
    "failed",
})


class MigrationError(RuntimeError):
    """Database migration could not be completed safely."""


def migrate_v1_to_v2(connection):
    """
    Atomically migrate schema v1 to schema v2.

    The caller must supply an idle SQLite connection with
    foreign-key enforcement enabled.

    Historical running records are moved to paused because
    their elapsed fermentation time cannot be reconstructed.
    """
    if connection.in_transaction:
        raise MigrationError(
            "Migration requires a connection without "
            "an active transaction"
        )

    foreign_keys = connection.execute(
        "PRAGMA foreign_keys"
    ).fetchone()[0]

    if foreign_keys != 1:
        raise MigrationError(
            "Foreign-key enforcement must be enabled"
        )

    try:
        connection.execute("BEGIN IMMEDIATE")

        row = connection.execute(
            "SELECT value FROM metadata "
            "WHERE key = 'schema_version'"
        ).fetchone()

        if row is None or row[0] != "1":
            raise MigrationError(
                "Migration requires schema version 1"
            )

        connection.execute(
            """
            CREATE TABLE fermentation_runs_v2 (
                id TEXT PRIMARY KEY,
                recipe_id TEXT NOT NULL,
                recipe_snapshot TEXT NOT NULL,
                status TEXT NOT NULL
                    CHECK (
                        status IN (
                            'created',
                            'running',
                            'paused',
                            'completed',
                            'cancelled',
                            'failed'
                        )
                    ),
                created_at TEXT NOT NULL,
                started_at TEXT,
                completed_at TEXT,
                elapsed_seconds INTEGER NOT NULL DEFAULT 0
                    CHECK (elapsed_seconds >= 0),
                running_since TEXT,
                paused_at TEXT,
                ended_at TEXT,
                failure_reason TEXT,
                FOREIGN KEY (recipe_id)
                    REFERENCES recipes(id)
                    ON DELETE RESTRICT
            )
            """
        )

        connection.execute(
            """
            INSERT INTO fermentation_runs_v2 (
                id,
                recipe_id,
                recipe_snapshot,
                status,
                created_at,
                started_at,
                completed_at,
                elapsed_seconds,
                running_since,
                paused_at,
                ended_at,
                failure_reason
            )
            SELECT
                id,
                recipe_id,
                recipe_snapshot,
                CASE
                    WHEN status = 'running'
                    THEN 'paused'
                    ELSE status
                END,
                created_at,
                started_at,
                completed_at,
                0,
                NULL,
                NULL,
                CASE
                    WHEN status IN (
                        'completed',
                        'cancelled',
                        'failed'
                    )
                    THEN completed_at
                    ELSE NULL
                END,
                CASE
                    WHEN status = 'running'
                    THEN 'Interrupted legacy run; '
                         || 'elapsed time unknown'
                    ELSE NULL
                END
            FROM fermentation_runs
            """
        )

        original_count = connection.execute(
            "SELECT COUNT(*) FROM fermentation_runs"
        ).fetchone()[0]

        migrated_count = connection.execute(
            "SELECT COUNT(*) FROM fermentation_runs_v2"
        ).fetchone()[0]

        if original_count != migrated_count:
            raise MigrationError(
                "Migration record count mismatch"
            )

        connection.execute(
            "DROP TABLE fermentation_runs"
        )

        connection.execute(
            "ALTER TABLE fermentation_runs_v2 "
            "RENAME TO fermentation_runs"
        )

        violations = connection.execute(
            "PRAGMA foreign_key_check"
        ).fetchall()

        if violations:
            raise MigrationError(
                "Foreign-key violations detected"
            )

        connection.execute(
            """
            UPDATE metadata
            SET value = '2'
            WHERE key = 'schema_version'
            """
        )

        connection.commit()

    except Exception:
        connection.rollback()
        raise


def migrate_v2_to_v3(connection):
    """
    Atomically migrate schema v2 to schema v3.

    Elapsed microseconds become the authoritative
    persisted fermentation-time measurement.

    Historical running records are conservatively
    paused without counting unobserved downtime.
    """
    if connection.in_transaction:
        raise MigrationError(
            "Migration requires an idle connection"
        )

    foreign_keys = connection.execute(
        "PRAGMA foreign_keys"
    ).fetchone()[0]

    if foreign_keys != 1:
        raise MigrationError(
            "Foreign-key enforcement must be enabled"
        )

    max_seconds = (
        9223372036854775807 // 1000000
    )

    try:
        connection.execute("BEGIN IMMEDIATE")

        row = connection.execute(
            """
            SELECT value
            FROM metadata
            WHERE key = 'schema_version'
            """
        ).fetchone()

        if row is None or row[0] != "2":
            raise MigrationError(
                "Migration requires schema version 2"
            )

        invalid_elapsed = connection.execute(
            """
            SELECT COUNT(*)
            FROM fermentation_runs
            WHERE
                typeof(elapsed_seconds) != 'integer'
                OR elapsed_seconds < 0
                OR elapsed_seconds > ?
            """,
            (max_seconds,),
        ).fetchone()[0]

        if invalid_elapsed:
            raise MigrationError(
                "Invalid or overflowing elapsed seconds"
            )

        connection.execute(
            """
            CREATE TABLE fermentation_runs_v3 (
                id TEXT PRIMARY KEY,
                recipe_id TEXT NOT NULL,
                recipe_snapshot TEXT NOT NULL,

                status TEXT NOT NULL
                    CHECK (
                        status IN (
                            'created',
                            'running',
                            'paused',
                            'completed',
                            'cancelled',
                            'failed'
                        )
                    ),

                created_at TEXT NOT NULL,
                started_at TEXT,
                completed_at TEXT,

                elapsed_seconds INTEGER NOT NULL DEFAULT 0
                    CHECK (elapsed_seconds >= 0),

                elapsed_microseconds INTEGER NOT NULL DEFAULT 0
                    CHECK (elapsed_microseconds >= 0),

                running_since TEXT,
                paused_at TEXT,
                ended_at TEXT,
                failure_reason TEXT,

                CHECK (
                    elapsed_seconds =
                    elapsed_microseconds / 1000000
                ),

                FOREIGN KEY (recipe_id)
                    REFERENCES recipes(id)
                    ON DELETE RESTRICT
            )
            """
        )

        connection.execute(
            """
            INSERT INTO fermentation_runs_v3 (
                id,
                recipe_id,
                recipe_snapshot,
                status,
                created_at,
                started_at,
                completed_at,
                elapsed_seconds,
                elapsed_microseconds,
                running_since,
                paused_at,
                ended_at,
                failure_reason
            )
            SELECT
                id,
                recipe_id,
                recipe_snapshot,

                CASE
                    WHEN status = 'running'
                    THEN 'paused'
                    ELSE status
                END,

                created_at,
                started_at,
                completed_at,

                elapsed_seconds,
                elapsed_seconds * 1000000,

                CASE
                    WHEN status = 'running'
                    THEN NULL
                    ELSE running_since
                END,

                CASE
                    WHEN status = 'running'
                    THEN COALESCE(
                        running_since,
                        started_at,
                        created_at
                    )
                    ELSE paused_at
                END,

                ended_at,

                CASE
                    WHEN status = 'running'
                    THEN
                        'Interrupted during schema migration; '
                        || 'unobserved elapsed time excluded'
                    ELSE failure_reason
                END

            FROM fermentation_runs
            """
        )

        original_count = connection.execute(
            """
            SELECT COUNT(*)
            FROM fermentation_runs
            """
        ).fetchone()[0]

        migrated_count = connection.execute(
            """
            SELECT COUNT(*)
            FROM fermentation_runs_v3
            """
        ).fetchone()[0]

        if original_count != migrated_count:
            raise MigrationError(
                "Migration record count mismatch"
            )

        connection.execute(
            "DROP TABLE fermentation_runs"
        )

        connection.execute(
            """
            ALTER TABLE fermentation_runs_v3
            RENAME TO fermentation_runs
            """
        )

        violations = connection.execute(
            "PRAGMA foreign_key_check"
        ).fetchall()

        if violations:
            raise MigrationError(
                "Foreign-key violations detected"
            )

        integrity = connection.execute(
            "PRAGMA integrity_check"
        ).fetchone()

        if integrity is None or integrity[0] != "ok":
            raise MigrationError(
                "Database integrity check failed"
            )

        connection.execute(
            """
            UPDATE metadata
            SET value = '3'
            WHERE key = 'schema_version'
            """
        )

        connection.commit()

    except Exception:
        connection.rollback()
        raise
